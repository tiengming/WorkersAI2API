{
  "name": "workers-ai2api",
  "version": "2.0.0",
  "private": true,
  "description": "OpenAI-compatible gateway for Cloudflare Workers AI with a dynamic, free-tier-aware model catalog.",
  "type": "module",
  "main": "_worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
